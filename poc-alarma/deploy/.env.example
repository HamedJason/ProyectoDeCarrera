# Copiar este archivo como .env dentro de la carpeta deploy y cambiar los valores.
# El archivo .env NO se sube al repositorio.

# Credenciales de PostgreSQL. Solo se usan dentro de la red interna de Docker,
# pero conviene poner una contraseña propia y no dejar la de ejemplo.
POSTGRES_USER=alarma
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=alarma_poc

# Token que debe enviar el ESP32 en el encabezado X-Device-Token.
# Debe coincidir exactamente con el del firmware.
DEVICE_TOKEN=poc-token-demo
