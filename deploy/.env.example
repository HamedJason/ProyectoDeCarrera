# Copiar este archivo como .env dentro de la carpeta deploy y cambiar los valores.
# El archivo .env NO se sube al repositorio.

# Credenciales de PostgreSQL. Solo se usan dentro de la red interna de Docker,
# pero conviene poner una contraseña propia y no dejar la de ejemplo.
POSTGRES_USER=alarma
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=alarma_poc

# Token que debe enviar el ESP32 en el encabezado X-Device-Token.
# Debe coincidir exactamente con el del firmware.
DEVICE_TOKEN=poc-token-demo

# Puerto del equipo donde se publica el backend. Por defecto 8080.
# En local, si el 8080 esta ocupado por otro proyecto, usar por ejemplo 8090.
# BACKEND_PORT=8080

# Notificaciones push con ntfy (https://ntfy.sh). Deja NTFY_TOPIC vacio para
# desactivarlas. El nombre del tema funciona como una contrasena: quien lo
# conozca puede leer los avisos, asi que usa uno largo y dificil de adivinar.
# NTFY_TOPIC=alarma-uabc-cambia-esto-por-algo-largo
# NTFY_URL=https://ntfy.sh

# Habilita el boton de borrar historial en la app. Solo durante las pruebas.
# MODO_PRUEBAS=true

# ---- Cuentas y camara (opcionales; estos son los valores por omision) ----
# La primera cuenta que se crea hereda las viviendas existentes. Despues el
# registro se cierra y se entra con codigo de invitacion, salvo que pongas true.
# REGISTRO_ABIERTO=false
# Fotos de la camara (disco del VPS: 40 GB). No se guarda video.
# FOTOS_DIAS=14
# FOTOS_MB_VIVIENDA=300
# FOTOS_MB_TOTAL=1500
# FOTOS_MIN_LIBRE_MB=1500
# Vista en vivo: tope por sesion y por dia, para cuidar CPU y ancho de banda
# VIVO_SESION_MAX_S=300
# VIVO_DIA_MAX_MIN=60
# CAMARA_RAFAGA=3

# ---- Camara MC210 por el tunel WireGuard (opcional; desactivado por omision) ----
# Requiere el puente del ESP32-S3 funcionando (ver firmware/puente_camara_s3).
# La clave es la de la cuenta de la camara creada en su app; no la subas a git.
# Eventos de personas y movimiento (ONVIF). Registran y avisan; solo suenan la alarma si defines ONVIF_SIRENA.
# ONVIF_ACTIVO=1
# ONVIF_VIVIENDA_ID=casa-001
# ONVIF_USUARIO=
# ONVIF_CLAVE=
# ONVIF_HOST=10.8.0.2
# ONVIF_ALERTAR=persona            # persona | movimiento | persona,movimiento
# ONVIF_SOLO_ARMADO=1              # 0 para avisar tambien con el sistema desarmado
# ONVIF_SIRENA=persona             # vacio = nunca suena. persona (o movimiento): con la casa armada marca la alarma y enciende la salida
# (recomendado: ONVIF_SIRENA=persona y ONVIF_ALERTAR=persona,movimiento: el movimiento solo avisa para que mires la camara)
# ONVIF_SIRENA_S=30                # segundos que suena
# ONVIF_RETARDO_SALIDA_S=60        # tras armar, la camara no avisa ni suena durante estos segundos (0 = sin retardo)
# ONVIF_COOLDOWN_PERSONA_S=60
# ONVIF_COOLDOWN_MOVIMIENTO_S=120
# ONVIF_LOG_XML=/app/datos/onvif.xml.log   # guarda los XML (sin credenciales) para diagnostico
# Fotos y vista en vivo por RTSP, solo cuando alguien las pide o salta un aviso.
# CAMARA_RTSP_ACTIVO=1
# CAMARA_TOKEN=                    # dejalo vacio: el agente usa un token interno del servidor
# CAMARA_VIVO_FPS=10               # cuadros por segundo de la vista en vivo (mide con: docker exec alarma_backend node camara_medir.js)
# CAMARA_VIVO_ANCHO=640            # ancho en pixeles del video en vivo
# CUADRO_MAX_KB=150                # un cuadro mas grande se descarta

# Origenes extra autorizados por CORS (separados por coma). Vacio = ninguno; la
# interfaz web no lo necesita porque se sirve desde el mismo servidor.
# CORS_ORIGEN=
