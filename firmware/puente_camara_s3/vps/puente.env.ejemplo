# Copiar a puente.env (permisos 600) y completar. NO subir puente.env a git.
#
#   cp puente.env.ejemplo puente.env && chmod 600 puente.env
#
# Formato: CLAVE=valor, una por linea. Los scripts leen este archivo como TEXTO
# (no lo ejecutan), asi que la clave puede llevar simbolos sin comillas.

# Direccion de la camara VISTA DESDE EL VPS: es la IP del ESP32 dentro del
# tunel, no la 192.168.4.x. Los puertos 554 y 2020 se reenvian con "portmap ... VPN".
CAMARA_IP_TUNEL=10.8.0.2

# Cuenta de camara creada en la app Tapo (Ajustes avanzados > Cuenta de la camara).
CAMARA_USUARIO=
CAMARA_CLAVE=

RTSP_PUERTO=554
ONVIF_PUERTO=2020

# stream1 = calidad alta, stream2 = calidad baja. Empezar siempre con stream2.
RTSP_RUTA=stream2

# Interfaz de WireGuard en el VPS.
WG_IF=wg0
