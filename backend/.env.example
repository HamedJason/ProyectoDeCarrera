# Copiar este archivo como .env y llenar los valores reales.
# El archivo .env NO debe subirse al repositorio.

# Cadena de conexion de PostgreSQL.
# Neon, Supabase y Render la entregan ya armada al crear la base de datos.
DATABASE_URL=postgresql://usuario:password@host/nombre_bd?sslmode=require

# Token simple que debe enviar el ESP32 en el encabezado X-Device-Token.
# No es el esquema de seguridad definitivo del proyecto.
DEVICE_TOKEN=poc-token-demo

# Puerto local. En Render esta variable la asigna el propio servicio.
PORT=3000
